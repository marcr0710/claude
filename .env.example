# Vercel Postgres (Neon) - required for data persistence
# These are injected automatically when you link a Postgres store in the
# Vercel dashboard: Storage → Create → Postgres → connect to project
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
